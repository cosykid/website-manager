# Every value here is optional: the defaults below are built in and match
# docker-compose.yml. Copy this file to .env.local only to change something.

# Where MongoDB is. For Atlas, paste the connection string from the Atlas UI.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=website_manager

# Where rendered public pages are kept. Without Redis the sites still work, and
# render each page every time it is asked for.
REDIS_URL=redis://127.0.0.1:6380

# Hostnames that show the manager. A request on any other hostname is treated
# as a public site and looked up in the sites collection.
MANAGER_HOSTS=localhost,127.0.0.1
